$ GOSUB DISPLAY
$ QUEUE= "PROD_PAYR_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "PROD_ASO_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "RPTDB_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "HGS000_VIP_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "HGS000_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "HGS001_VIP_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "HGS001_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "SYS$PRINT"
$ BLOCKS = F$GETQUI("DISPLAY_QUEUE","PENDING_JOB_BLOCK_COUNT","''QUEUE'")
$ HOLD = F$GETQUI("DISPLAY_QUEUE","HOLDING_JOB_COUNT","''QUEUE'")
$ EXEC = F$GETQUI("DISPLAY_QUEUE","EXECUTING_JOB_COUNT","''QUEUE'")
$ PEND = F$GETQUI("DISPLAY_QUEUE","PENDING_JOB_COUNT","''QUEUE'")
$ QNAME = F$GETQUI("DISPLAY_QUEUE","QUEUE_NAME","*''QUEUE'*","BATCH,SYMBIONT")
$ EXEC1 = F$GETQUI("DISPLAY_JOB","JOB_NAME",,"ALL_JOBS,EXECUTING_JOBS")
$ DISP = "''QUEUE'"+": EXEC "+F$STRING(EXEC)+" PEND: "+F$STRING(PEND)+","-
+F$STRING(BLOCKS)+" HOLD: "+F$STRING(HOLD)+ "->" + EXEC1
$ DISPLAY "''DISP'"

$ QUEUE= "DP350HC"
$ BLOCKS = F$GETQUI("DISPLAY_QUEUE","PENDING_JOB_BLOCK_COUNT","''QUEUE'")
$ HOLD = F$GETQUI("DISPLAY_QUEUE","HOLDING_JOB_COUNT","''QUEUE'")
$ EXEC = F$GETQUI("DISPLAY_QUEUE","EXECUTING_JOB_COUNT","''QUEUE'")
$ PEND = F$GETQUI("DISPLAY_QUEUE","PENDING_JOB_COUNT","''QUEUE'")
$ QNAME = F$GETQUI("DISPLAY_QUEUE","QUEUE_NAME","*''QUEUE'*","BATCH,SYMBIONT")
$ EXEC1 = F$GETQUI("DISPLAY_JOB","JOB_NAME",,"ALL_JOBS,EXECUTING_JOBS")
$ DISP = "''QUEUE'"+": EXEC "+F$STRING(EXEC)+" PEND: "+F$STRING(PEND)+","-
+F$STRING(BLOCKS)+" HOLD: "+F$STRING(HOLD)+ "->" + EXEC1
