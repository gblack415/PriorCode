$! FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$! MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$! IF (FREEBLOCKS .LE. 10000) THEN GOTO STOPIT
$! FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(WP)		" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$! DISPLAY FREE
$! DRIVE = "DSA630"
$! FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$! MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$! IF (FREEBLOCKS .LE. 10000) THEN GOTO STOPIT
$! FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(WPMAIL)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$! DISPLAY FREE
$! DRIVE = "DSA700"
$! FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$! MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$! IF (FREEBLOCKS .LE. 10000) THEN GOTO STOPIT
$! FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(DATA)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$! DISPLAY FREE
