$!THIS PROGRAM DISPLAYS THE STATUS OF ALL PRODUCTION QUEUES 11/11/94 GLB
$!DISPLAYS QUEUE INFO
$!12.6.95 GLB UPDATED CLEARSCREEN AND QUEUE QUERY
$ SET NOVERIFY
$ DISPLAY :== "WRITE SYS$OUTPUT"
$ SET CONTROL
$ LOOP1:
$ WRITE SYS$OUTPUT "[1;1H[2J"
$!=========================================
$! DISPLAY
$!=========================================
$ QUEUE= "PROD_HMO_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "PROD_SHHS_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "PROD_MCAR_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "PROD_LCSA_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "PROD_HGO_BATCH"
$ GOSUB DISPLAY
$ QUEUE= "PROD_PCO_BATCH"
$ GOSUB DISPLAY
