$ FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$ MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$ FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(LOGS AND REPORTS)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$ DISPLAY FREE
$ DRIVE = "DSA720"
$ FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$ MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$ IF (FREEBLOCKS .LE. 10000) THEN GOTO STOPIT
$ FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(RDB DATA)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$ DISPLAY FREE
$ DRIVE = "DSA730"
$ FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$ MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$ IF (FREEBLOCKS .LE. 10000) THEN GOTO STOPIT
$ FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(CLAIM DATA)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$ DISPLAY FREE
$ SKIPIT:
$ DRIVE = "$1$DIA0"
$ FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$ MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$ FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(SYSTEM DISK)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$ DISPLAY FREE
$ DRIVE = "$1$DKA0"
$ FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$ MAXBLOCKS  = F$GETDVI("''DRIVE'","MAXBLOCK")
$ FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(PROG AREA)	" +F$STRING(FREEBLOCKS*100/MAXBLOCKS)+ "%"
$ DISPLAY FREE
$! DRIVE = "$1$DIA3"
$! FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$! FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS (DCORPS SOURCE DISK)"
$! DISPLAY FREE
$! DRIVE = "$1$DIA4"
$! FREEBLOCKS = F$GETDVI("''DRIVE'","FREEBLOCKS")
$! FREE = "''DRIVE'="+F$STRING(FREEBLOCKS)+" BLOCKS(PROG SPACE)"
$! DISPLAY FREE
$ SH TI
$ WAIT 00:00:03
$ GOTO LOOP1
$ DISPLAY:
$ HOLD = F$GETQUI("DISPLAY_QUEUE","HOLDING_JOB_COUNT","''QUEUE'")
$ EXEC = F$GETQUI("DISPLAY_QUEUE","EXECUTING_JOB_COUNT","''QUEUE'")
$ PEND = F$GETQUI("DISPLAY_QUEUE","PENDING_JOB_COUNT","''QUEUE'")
$ QNAME = F$GETQUI("DISPLAY_QUEUE","QUEUE_NAME","*''QUEUE'*","BATCH")
$ DISP = "''QUEUE'"+": EXEC "+F$STRING(EXEC)+" PEND: "+F$STRING(PEND)+-
" HOLD: "+F$STRING(HOLD)+"''DESC'"
$ DISPLAY "''DISP'"
$ LOOPEXE:
$ EXEC = F$GETQUI("DISPLAY_JOB","JOB_NAME",,"ALL_JOBS,EXECUTING_JOBS")
$ IF (EXEC .NES. "") 
$    THEN
$    EXECE= F$GETQUI("DISPLAY_JOB","ENTRY_NUMBER",,"FREEZE_CONTEXT")
$    DISPLAY F$STRING(EXECE),"-E>"+EXEC
$ ENDIF
$ IF EXEC .NES. "" THEN GOTO LOOPEXE
$ RETURN
$ STOPIT:
$! STOP/QUEUE PROD_HMO_BATCH
$! STOP/QUEUE PROD_ASO_BATCH
$! STOP/QUEUE PROD_TPA_BATCH
$! STOP/QUEUE PROD_LCSA_BATCH
